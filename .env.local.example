# Supabase — copy to .env.local and fill with YOUR keys (never commit .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Shared secret for Team Calendar hub message feed
TEAM_CALENDAR_API_KEY=change-me-team-calendar-key

# Postgres direct connection — for `npm run backup` only (Supabase → Database → Connection string → URI, port 5432)
# DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# OpenAI
OPENAI_API_KEY=your-openai-api-key

# Google Maps — site location picker (Maps JavaScript + Places + Geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# OpenWeatherMap — live weather widget (read by the server /api/weather route)
NEXT_PUBLIC_WEATHER_API_KEY=your-openweathermap-api-key
WEATHER_API_KEY=your-openweathermap-api-key

# Android accountant shell (Capacitor / emulator). Examples:
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000
# CAPACITOR_SERVER_URL=https://your-production-host
